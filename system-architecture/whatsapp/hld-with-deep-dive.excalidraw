    },
    {
      "id": "nXZnROdOwIuwz32oUHS0A",
      "type": "text",
      "x": 966.7050067538545,
      "y": 6349.236143283476,
      "width": 1829.423095703125,
      "height": 440.42629104263597,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1F",
      "roundness": null,
      "seed": 1743690964,
      "version": 1740,
      "versionNonce": 480836436,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1774162043389,
      "link": null,
      "locked": false,
      "text": "Option B: Zookeeper/etcd with consistent hash ring. [acts as Control plane]\n----------------------------------------------------------------\n- idea is if we can predictably know, which user is connected to which server, \nwe can just route the message to that server.\n- Don't need a load balancer in this case.\n- These control planes (zookeeper/etcs) don't need to scale, since they're only keeping the track of live \nchat servers. They only become active when a server crashes or new server is added. In which case, the \nserver pull all the server configs (5-6k) locally and then never talk to etcd again.\n_ The chat server locally calculates the hash using the consistent hash ring algorithm and then uses the \nlocal cache fetched from etcd to find the server's IP for the given hash value.",
      "fontSize": 35.234103283410874,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Option B: Zookeeper/etcd with consistent hash ring. [acts as Control plane]\n----------------------------------------------------------------\n- idea is if we can predictably know, which user is connected to which server, \nwe can just route the message to that server.\n- Don't need a load balancer in this case.\n- These control planes (zookeeper/etcs) don't need to scale, since they're only keeping the track of live \nchat servers. They only become active when a server crashes or new server is added. In which case, the \nserver pull all the server configs (5-6k) locally and then never talk to etcd again.\n_ The chat server locally calculates the hash using the consistent hash ring algorithm and then uses the \nlocal cache fetched from etcd to find the server's IP for the given hash value.",
      "autoResize": true,
      "lineHeight": 1.25
    },
