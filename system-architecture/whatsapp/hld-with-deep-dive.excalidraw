    {
      "id": "cB-whC_nSHjPIaB9KC1Ow",
      "type": "text",
      "x": 1299.227379831607,
      "y": 6794.797672402336,
      "width": 1483.6676025390625,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1P",
      "roundness": null,
      "seed": 1611452116,
      "version": 1232,
      "versionNonce": 2058968276,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774162043389,
      "link": null,
      "locked": false,
      "text": "Data flow:\n-------------\n1. User A goes to chatRegistry to establish a new connection.\n2. chatRegistry says, connect to server1.\n3. User A drops a message to user B.\n4. Server1 writes to database, goes to zookeeper to identify the server for user B.\n5. Internally routes the message to server2 (userB connected to this server).\n6. server2 is going to check it's internal hashmap, to confirm that userB is indeed\n   connected to server2.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Data flow:\n-------------\n1. User A goes to chatRegistry to establish a new connection.\n2. chatRegistry says, connect to server1.\n3. User A drops a message to user B.\n4. Server1 writes to database, goes to zookeeper to identify the server for user B.\n5. Internally routes the message to server2 (userB connected to this server).\n6. server2 is going to check it's internal hashmap, to confirm that userB is indeed\n   connected to server2.",
      "autoResize": true,
      "lineHeight": 1.25
    },
