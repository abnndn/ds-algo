      "versionNonce": 485853548,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1774158004141,
      "link": null,
      "locked": false,
      "text": "Option B: Zookeeper/etcd with consistent hash ring.\n- idea is if we can predictably know, which user is connected to which server, \nwe can just route the message to that server.",
      "fontSize": 35.234103283410874,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Option B: Zookeeper/etcd with consistent hash ring.\n- idea is if we can predictably know, which user is connected to which server, \nwe can just route the message to that server.",
      "autoResize": true,
      "lineHeight": 1.25
    },
