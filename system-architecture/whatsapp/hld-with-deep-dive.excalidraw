      "seed": 717282900,
      "version": 455,
      "versionNonce": 1505039084,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774162323918,
      "link": null,
      "locked": false,
      "text": "Idea for whatsapp is, after 30 days, if you haven't recieved your message,\nyou're not going to get it.\nDon't want to keep around the messages that you don't need to, because \nthey end up being a privacy liability, which in case of meta is incredibally \nimportant and is very expensive when they get it wrong.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Idea for whatsapp is, after 30 days, if you haven't recieved your message,\nyou're not going to get it.\nDon't want to keep around the messages that you don't need to, because \nthey end up being a privacy liability, which in case of meta is incredibally \nimportant and is very expensive when they get it wrong.",
      "autoResize": true,
      "lineHeight": 1.25
    },
