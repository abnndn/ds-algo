    {
      "id": "ym_2guy_g44WNHajoUQ58",
      "type": "text",
      "x": 1357.015899270129,
      "y": 6739.663619894731,
      "width": 1122.695556640625,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1D",
      "roundness": null,
      "seed": 755892692,
      "version": 414,
      "versionNonce": 987559020,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1774157905679,
      "link": null,
      "locked": false,
      "text": "Not a very good solution:\n- kafka not architecte for billions of topics.\n- per topic, size is 50-100KB. doesn't work for billions of users.\n- not created for these small lived topics, i.e. micro topics.\n ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Not a very good solution:\n- kafka not architecte for billions of topics.\n- per topic, size is 50-100KB. doesn't work for billions of users.\n- not created for these small lived topics, i.e. micro topics.\n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "liP7fbXLyr9OSee9otiyw",
      "type": "rectangle",
      "x": 1028.1516321932238,
      "y": 6523.645707809304,
      "width": 1569.1456268947106,
      "height": 410.24079321448517,
      "angle": 0,
      "strokeColor": "#1e1e1e",
