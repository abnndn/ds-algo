    {
      "id": "rcSRFFkrTXm3NG1Yxm_qg",
      "type": "text",
      "x": 1063.3180738345307,
      "y": 8534.352020921666,
      "width": 1524.9237060546875,
      "height": 360,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
