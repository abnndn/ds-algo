    {
      "id": "KgqMmXxvzEmDW1nVfnsAi",
      "type": "text",
      "x": 1117.693917749024,
      "y": 4680.752759249415,
      "width": 1122.695556640625,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0a",
      "roundness": null,
      "seed": 1298517228,
      "version": 548,
      "versionNonce": 1254092268,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774162117507,
      "link": null,
      "locked": false,
      "text": "Not a very good solution:\n-------------------------------\n- kafka not architecte for billions of topics.\n- per topic, size is 50-100KB. doesn't work for billions of users.\n- not created for these small lived topics, i.e. micro topics.\n ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Not a very good solution:\n-------------------------------\n- kafka not architecte for billions of topics.\n- per topic, size is 50-100KB. doesn't work for billions of users.\n- not created for these small lived topics, i.e. micro topics.\n ",
      "autoResize": true,
      "lineHeight": 1.25
    },
