    {
      "id": "Hgo8z_xZfuqUuoECV54Je",
      "type": "text",
      "x": 2173.965558801128,
      "y": 3411.444880283104,
      "width": 957.4916381835938,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ao",
      "roundness": null,
      "seed": 255556820,
      "version": 332,
      "versionNonce": 1007104620,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1774115845743,
      "link": null,
      "locked": false,
      "text": "[This table is used to keep the data \nfor delivering messages.\nIf the message is delivered to recipient, the \nentry from this table will be deleted.\nIf the client was offline, and comes online, chat server\nwill fetch messages from this DB and unload them to \nclients, and delete from this table.]",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "[This table is used to keep the data \nfor delivering messages.\nIf the message is delivered to recipient, the \nentry from this table will be deleted.\nIf the client was offline, and comes online, chat server\nwill fetch messages from this DB and unload them to \nclients, and delete from this table.]",
      "autoResize": true,
      "lineHeight": 1.25
    },
