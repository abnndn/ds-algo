    {
      "id": "4zESkz2C46C0retYfC3I-",
      "type": "text",
      "x": 396.07520428043483,
      "y": 1931.470311965516,
      "width": 1232.61669921875,
      "height": 70.7776349019332,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2g",
      "roundness": null,
      "seed": 1581849171,
      "version": 229,
      "versionNonce": 530450365,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773818885383,
      "link": null,
      "locked": false,
      "text": "Consumers periodically commit that last read offset, incase of outages at consumer side.\nKafka maintains what the latest offset was, when it was read.",
      "fontSize": 28.31105396077328,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Consumers periodically commit that last read offset, incase of outages at consumer side.\nKafka maintains what the latest offset was, when it was read.",
      "autoResize": true,
      "lineHeight": 1.25
    },
