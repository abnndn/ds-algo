      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0F",
      "roundness": null,
      "seed": 505060686,
      "version": 245,
      "versionNonce": 790786894,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1775534626180,
      "link": null,
      "locked": false,
      "text": "SortedSet is doing computation\nin memory so it's very fast.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SortedSet is doing computation\nin memory so it's very fast.",
