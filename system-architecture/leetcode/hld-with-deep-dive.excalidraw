      "isDeleted": false,
      "boundElements": null,
      "updated": 1775534626180,
      "link": null,
      "locked": false,
      "text": "Benifit of sorted set:\n---------------------------\nAllows us to do ranged query.\nRetrieve all the elements b/w\nspecific score range.\nEg: Get me all the users with \nrank 101 to 200. For the\npaginated queries.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Benifit of sorted set:\n---------------------------\nAllows us to do ranged query.\nRetrieve all the elements b/w\nspecific score range.\nEg: Get me all the users with \nrank 101 to 200. For the\npaginated queries.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oO6Dbcnbl09ycdIwxu4bh",
      "type": "text",
      "x": 1895.9008086745202,
