      "locked": false,
      "text": "Inefficient solution to generate the leaderboard:\n----------------------------------------------------------\nSELECT\n    userId,\n    COUNT(*) as passedSubmissions\n    MIN(lastSubmissionTime)\nFROM\n    submissions\nWHERE\n    competitionId = {competitionId} AND\nGROUP BY\n    userId\nORDER BY\n    passedSubmissions DESC,\n    lastSubmissionTime ASC",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Inefficient solution to generate the leaderboard:\n----------------------------------------------------------\nSELECT\n    userId,\n    COUNT(*) as passedSubmissions\n    MIN(lastSubmissionTime)\nFROM\n    submissions\nWHERE\n    competitionId = {competitionId} AND\nGROUP BY\n    userId\nORDER BY\n    passedSubmissions DESC,\n    lastSubmissionTime ASC",
