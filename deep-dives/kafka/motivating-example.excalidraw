      "updated": 1773814769839,
      "link": null,
      "locked": false,
      "text": "Consumer Groups makes a promise that each event will only be processed by 1 consumer in that consumer group,\nSo there's no chance for processing a single event twice.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Consumer Groups makes a promise that each event will only be processed by 1 consumer in that consumer group,\nSo there's no chance for processing a single event twice.",
      "autoResize": true,
      "lineHeight": 1.25
    },
