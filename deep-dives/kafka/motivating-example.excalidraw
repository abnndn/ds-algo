      "updated": 1773814418886,
      "link": null,
      "locked": false,
      "text": "Problem 3: When you scale too much, Consumer can't keep up with the rate of new events.\nSolution 3: Consumer Groups.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Problem 3: When you scale too much, Consumer can't keep up with the rate of new events.\nSolution 3: Consumer Groups.",
