    {
      "id": "G3Iiq6RseN21lyWBrUuf1",
      "type": "text",
      "x": -1932.081780272651,
      "y": -302.4777116566247,
      "width": 1687.78759765625,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aU",
      "roundness": null,
      "seed": 521274434,
      "version": 431,
      "versionNonce": 1348384862,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773814408773,
      "link": null,
      "locked": false,
      "text": "Problem 1: Too many events on the queue, the server hosting the queue is running out of space.\nSolution 1: Scale Horizontally (more servers).",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Problem 1: Too many events on the queue, the server hosting the queue is running out of space.\nSolution 1: Scale Horizontally (more servers).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "C9UNUP8ecnpPwOUAnWzzf",
      "type": "text",
      "x": -1925.157952147651,
      "y": -125.0363054066247,
      "width": 1156.9676513671875,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aV",
      "roundness": null,
      "seed": 87076930,
      "version": 458,
      "versionNonce": 1561560670,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773814411015,
      "link": null,
      "locked": false,
      "text": "Problem 2: The events needs to be consumed in order.\nSolution 2: Partition by game, each queue is partitioned by game. ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Problem 2: The events needs to be consumed in order.\nSolution 2: Partition by game, each queue is partitioned by game. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RbAadueKWU1KVDQgK-4fZ",
      "type": "text",
      "x": -2012.989983397651,
      "y": 690.5398664683753,
      "width": 1829.267578125,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 880808514,
      "version": 260,
      "versionNonce": 1754468382,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773814415006,
      "link": null,
      "locked": false,
      "text": "Fundamental idea behind Kafka: In order to scale, messages and recieved through Kafka requires a user \nspecified distribution strategy.",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Fundamental idea behind Kafka: In order to scale, messages and recieved through Kafka requires a user \nspecified distribution strategy.",
      "autoResize": true,
      "lineHeight": 1.25
    },
